# Sources and build tooling — only the bundles in dist/ ship.
src/**
.vscode/**
.github/**
**/*.ts
**/*.map
tsconfig.json
esbuild.js
.gitignore
.editorconfig

# node_modules is excluded wholesale, then the one runtime dependency is added
# back. libredwg-web must ship: it is ESM loaded at runtime by the parse worker,
# and its .wasm has to sit next to its glue code, so it cannot be bundled.
node_modules/**
!node_modules/@mlightcad/libredwg-web/package.json
!node_modules/@mlightcad/libredwg-web/dist/**
!node_modules/@mlightcad/libredwg-web/lib/**
!node_modules/@mlightcad/libredwg-web/wasm/**
!node_modules/@mlightcad/libredwg-web/README.md
